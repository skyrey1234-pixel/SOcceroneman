# Required: must exactly match Base44's VISION_PROVIDER_TOKEN.
VISION_PROVIDER_TOKEN=replace-with-a-long-random-secret

# Required: hostnames allowed for direct Base44 file URLs. Leave empty only for a controlled pilot.
# Example: your-base44-storage-host.example.com
VISION_ALLOWED_HOSTS=

# Required: hostname of the Base44 function callback. This avoids callback SSRF.
# Example: app.base44.com
VISION_CALLBACK_ALLOWED_HOSTS=

# Leave false in production. The current Base44 callback must be public HTTPS.
VISION_ALLOW_HTTP_CALLBACK=false

# The initial CPU pilot accepts clips only, not full-match workloads.
VISION_MAX_DURATION_SECONDS=900
VISION_SAMPLE_FPS=1
VISION_MAX_EVENTS=40
VISION_MAX_REPLAY_FRAMES=32
VISION_MAX_CONCURRENT_JOBS=1
VISION_MAX_DOWNLOAD_BYTES=1610612736

# Bind to loopback; publish only through an authenticated HTTPS reverse proxy.
VISION_BIND_HOST=127.0.0.1
VISION_PORT=8123
VISION_WORKER_ROOT=/var/lib/socceroneman-vision
VISION_LOG_LEVEL=INFO
