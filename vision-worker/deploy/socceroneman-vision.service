[Unit]
Description=SOcceroneman MediaPipe vision worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vision
Group=vision
WorkingDirectory=/opt/socceroneman/vision-worker
EnvironmentFile=/etc/socceroneman-vision.env
ExecStart=/opt/socceroneman/vision-worker/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8123 --proxy-headers
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/socceroneman-vision

[Install]
WantedBy=multi-user.target
