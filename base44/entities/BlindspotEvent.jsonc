{
  "name": "BlindspotEvent",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "minute": {
      "type": "number"
    },
    "second": {
      "type": "number"
    },
    "observer_player": {
      "type": "number"
    },
    "missed_player": {
      "type": "number"
    },
    "severity": {
      "type": "number"
    },
    "distance_m": {
      "type": "number"
    },
    "angle_deg": {
      "type": "number"
    },
    "scan_quality": {
      "type": "number"
    },
    "pitch_x": {
      "type": "number",
      "description": "Observer position along the pitch, 0-105m"
    },
    "pitch_y": {
      "type": "number",
      "description": "Observer position across the pitch, 0-68m"
    },
    "phase": {
      "type": "string",
      "enum": [
        "build_up",
        "progression",
        "final_third",
        "defensive_transition",
        "settled_defence",
        "set_piece"
      ]
    },
    "what_went_right": {
      "type": "string"
    },
    "what_went_wrong": {
      "type": "string"
    },
    "feedback": {
      "type": "string"
    }
  },
  "required": [
    "match_id"
  ]
}