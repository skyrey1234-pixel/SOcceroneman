{
  "name": "BlindspotEvent",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "minute": {
      "type": "number"
    },
    "second": {
      "type": "number"
    },
    "timestamp_seconds": {
      "type": "number",
      "description": "Absolute match time in seconds used for footage seeking and deep links"
    },
    "observer_player": {
      "type": "number"
    },
    "missed_player": {
      "type": "number"
    },
    "severity": {
      "type": "number"
    },
    "distance_m": {
      "type": "number"
    },
    "angle_deg": {
      "type": "number"
    },
    "scan_quality": {
      "type": "number"
    },
    "pitch_x": {
      "type": "number",
      "description": "Observer position along the pitch, 0-105m"
    },
    "pitch_y": {
      "type": "number",
      "description": "Observer position across the pitch, 0-68m"
    },
    "phase": {
      "type": "string",
      "enum": [
        "build_up",
        "progression",
        "final_third",
        "defensive_transition",
        "settled_defence",
        "set_piece"
      ]
    },
    "what_went_right": {
      "type": "string"
    },
    "what_went_wrong": {
      "type": "string"
    },
    "feedback": {
      "type": "string"
    },
    "evidence_source": {
      "type": "string",
      "enum": [
        "ai_draft",
        "coach_marked",
        "computer_vision"
      ],
      "default": "ai_draft",
      "description": "Explains whether this is an AI draft, coach-created moment, or measured vision output"
    },
    "evidence_confidence": {
      "type": "number",
      "description": "Model or coach confidence from 0 to 1; only computer-vision values are measured"
    },
    "evidence_start_seconds": {
      "type": "number"
    },
    "evidence_end_seconds": {
      "type": "number"
    },
    "evidence_note": {
      "type": "string"
    },
    "evidence_thumbnail_url": {
      "type": "string"
    },
    "annotation_state": {
      "type": "string",
      "enum": [
        "none",
        "draft",
        "verified"
      ],
      "default": "none"
    },
    "observer_box": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "missed_player_box": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "replay_schema_version": {
      "type": "string",
      "description": "Versioned Time Machine replay payload contract"
    },
    "replay_status": {
      "type": "string",
      "enum": [
        "unavailable",
        "keyframe",
        "tracked"
      ],
      "default": "unavailable",
      "description": "Best replay fidelity available for this event"
    },
    "replay_keyframe_seconds": {
      "type": "number",
      "description": "Decision freeze timestamp in seconds"
    },
    "replay_sample_fps": {
      "type": "number",
      "description": "Sampling rate used to produce replay frames"
    },
    "replay_note": {
      "type": "string",
      "description": "Plain-language scope and confidence boundary for the replay"
    },
    "replay_frames": {
      "type": "array",
      "description": "Compact normalized overlay track for the event evidence window",
      "items": {
        "type": "object",
        "properties": {
          "timestamp_seconds": {
            "type": "number"
          },
          "track_id": {
            "type": "string"
          },
          "observer_box": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "context_box": {
            "type": "object",
            "description": "Nearby visual context; not a verified missed runner unless explicitly coach-marked",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "head_direction_proxy": {
            "type": "number",
            "description": "Camera-plane nose-to-shoulder offset proxy, not gaze or true yaw"
          },
          "observer_confidence": {
            "type": "number"
          }
        }
      }
    },
    "vision_analysis_id": {
      "type": "string"
    },
    "vision_track_id": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "dismissed"
      ],
      "default": "pending",
      "description": "Coach review state for this analysis event"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp recorded when a coach last changed the review state"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Authenticated coach user ID that last reviewed the event"
    }
  },
  "required": [
    "match_id"
  ]
}
