{
  "name": "Scenario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "ball": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "team": {
            "type": "string",
            "enum": [
              "home",
              "away"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "facing": {
            "type": "number"
          },
          "scan_quality": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}