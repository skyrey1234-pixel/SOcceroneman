{
  "name": "Match",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "opponent": {
      "type": "string"
    },
    "match_date": {
      "type": "string",
      "format": "date"
    },
    "competition": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "camera_type": {
      "type": "string",
      "enum": [
        "broadcast",
        "endzone",
        "phone"
      ],
      "default": "broadcast"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "analyzing",
        "complete",
        "failed"
      ],
      "default": "queued"
    },
    "frames_processed": {
      "type": "number"
    },
    "unique_players": {
      "type": "number"
    },
    "total_blindspots": {
      "type": "number"
    },
    "avg_scan_quality": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "analysis_error": {
      "type": "string",
      "description": "Most recent user-safe failure message from match analysis"
    },
    "vision_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "not_configured",
        "queued",
        "processing",
        "complete",
        "failed"
      ],
      "default": "not_requested"
    },
    "vision_analysis_id": {
      "type": "string"
    },
    "vision_provider": {
      "type": "string"
    },
    "vision_error": {
      "type": "string"
    },
    "vision_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "vision_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "video_duration_seconds": {
      "type": "number"
    }
  },
  "required": [
    "title"
  ]
}
